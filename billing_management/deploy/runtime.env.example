# Created separately for management and customer at /etc/billing-management/<area>.env.
# Never use the same token for both services. Deploy generates tokens if absent.
BILLING_PORT=5500
BILLING_API_HOST=ev.admin.api.example.com
BILLING_ALLOWED_ORIGIN=https://ev.admin.example.com
BILLING_API_TOKEN=GENERATE_A_UNIQUE_RANDOM_64_CHARACTER_LOWERCASE_HEX_TOKEN
# Management only. Persistent state lives outside release directories.
BILLING_DATABASE_PATH=/var/lib/billing-management/backoffice.sqlite3
BILLING_READER_TOKEN=GENERATE_A_DISTINCT_RANDOM_64_CHARACTER_LOWERCASE_HEX_TOKEN
BILLING_OPERATOR_TOKEN=GENERATE_A_DISTINCT_RANDOM_64_CHARACTER_LOWERCASE_HEX_TOKEN
# Optional loopback CSMS integration; deployment reads the existing server-only OCPP token.
BILLING_OCPP_HOST=ocpp.example.com
BILLING_OCPP_PORT=5003
BILLING_OCPP_TOKEN=EXISTING_SERVER_ONLY_OCPP_ADMIN_TOKEN
