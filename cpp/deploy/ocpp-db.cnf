[mariadbd]
basedir=/opt/ocpp-db/runtime/usr
datadir=/var/lib/ocpp-db
plugin_dir=/opt/ocpp-db/runtime/usr/lib/mysql/plugin
socket=/run/ocpp-db/mysql.sock
pid-file=/run/ocpp-db/mysql.pid
bind-address=127.0.0.1
port=3307
ssl-ca=/etc/ocpp-db/tls/ca.pem
ssl-cert=/etc/ocpp-db/tls/server.pem
ssl-key=/etc/ocpp-db/tls/server.key
tls-version=TLSv1.2,TLSv1.3
skip-name-resolve
character-set-server=utf8mb4
collation-server=utf8mb4_unicode_ci
default-time-zone=+00:00
sql-mode=STRICT_ALL_TABLES,NO_ZERO_DATE,NO_ZERO_IN_DATE
innodb-buffer-pool-size=64M
innodb-log-file-size=64M
innodb-flush-log-at-trx-commit=1
sync-binlog=1
max-connections=24
thread-cache-size=4
table-open-cache=256
performance-schema=OFF
local-infile=OFF
max-allowed-packet=16M
