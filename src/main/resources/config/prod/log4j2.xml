<?xml version="1.0" encoding="UTF-8"?>
<Configuration status="WARN">

    <Properties>
        <Property name="logPattern">[%-5p] %d - %m%n</Property>
    </Properties>

    <Appenders>
        <RollingRandomAccessFile name="FILE"
                                 fileName="${sys:user.home}/logs/ocpp.log"
                                 filePattern="${sys:user.home}/logs/ocpp-%d{yyyy-MM-dd}-%i.log.gz"
                                 immediateFlush="false"
                                 append="true"
                                 bufferSize="8192"> <!-- Increased buffer size to reduce frequent writes -->
            <PatternLayout pattern="${logPattern}"/>
            <Policies>
                <SizeBasedTriggeringPolicy size="5 MB"/>
                <TimeBasedTriggeringPolicy interval="1" modulate="true"/>
            </Policies>
            <DefaultRolloverStrategy max="20"/>
        </RollingRandomAccessFile>
    </Appenders>

    <Loggers>
        <!-- Disable the Jooq logo in logs -->
        <!-- https://github.com/jOOQ/jOOQ/issues/4019 -->
        <AsyncLogger name="org.jooq.Constants" level="WARN"/>
        <AsyncLogger name="org.apache.jasper" level="WARN"/>
        <AsyncLogger name="org.apache.tomcat.util" level="WARN"/>
        <AsyncLogger name="jndi" level="WARN"/>

        <!-- Specific package logging level -->
        <AsyncLogger name="de.rwth.idsg.steve.ocpp.ws" level="WARN"/>

        <AsyncRoot level="INFO">
            <AppenderRef ref="FILE"/>
        </AsyncRoot>
    </Loggers>
</Configuration>
