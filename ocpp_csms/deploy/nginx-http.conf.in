# Managed by cpp/deploy.ps1. This host only; ACME works before TLS activation.
server {
    listen 80;
    listen [::]:80;
    server_name @DOMAIN@;
    location ^~ /.well-known/acme-challenge/ {
        root /var/www/ocpp-acme;
        default_type text/plain;
        try_files $uri =404;
    }
    location / { return 503; }
}
