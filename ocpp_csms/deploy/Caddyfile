# Windows and Linux: set OCPP_PUBLIC_HOST to your DNS name and run Caddy separately.
# The C++ listener is intentionally restricted to loopback; Caddy terminates TLS.
# This sample exposes only charger endpoints. Put administration behind a private gateway.
{$OCPP_PUBLIC_HOST} {
    @chargers path /ocpp/* /steve/websocket/CentralSystemService/* /develop/websocket/CentralSystemService/* /services/CentralSystemService* /steve/services/CentralSystemService* /develop/services/CentralSystemService*
    reverse_proxy @chargers 127.0.0.1:5003 {
        stream_timeout 24h
    }
    header Strict-Transport-Security "max-age=31536000"
    respond 404
}
